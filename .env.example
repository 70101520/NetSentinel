POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://netsentinel:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/netsentinel
REDIS_URL=redis://redis:6379/0
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
JWT_ISSUER=netsentinel
ACCESS_TOKEN_MINUTES=15
AGENT_HEARTBEAT_TIMEOUT_SECONDS=180
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
MAX_PAGE_SIZE=100
SERVICE_TOKEN_PEPPER=CHANGE_ME_AT_LEAST_32_RANDOM_BYTES
TELEMETRY_STREAM=netsentinel:telemetry
TELEMETRY_GROUP=telemetry-workers
TELEMETRY_DLQ_STREAM=netsentinel:telemetry:dlq
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_MAX_BODY_BYTES=2097152
TELEMETRY_RATE_LIMIT_EVENTS=5000
TELEMETRY_RATE_WINDOW_SECONDS=60
TELEMETRY_QUEUE_WARNING=50000
TELEMETRY_QUEUE_CRITICAL=100000
TELEMETRY_WORKER_BATCH_SIZE=500
TELEMETRY_BLOCK_MS=2000
TELEMETRY_RECLAIM_IDLE_MS=30000
TELEMETRY_MAX_ATTEMPTS=5
TELEMETRY_DB_RETRY_BASE_SECONDS=1
